sharray: 60, 1000; stroke-dashoffset: -1000px; filter: drop-shadow(rgb(255, 77, 94) 0px 0px 4px); }\n.heart { transform-box: fill-box; transform-origin: 50% center; filter: drop-shadow(rgba(45, 212, 232, 0.7) 0px 0px 8px); }\n.heart.heart-alert { filter: drop-shadow(rgba(255, 77, 94, 0.75) 0px 0px 8px); }\n.heart-glow { fill: rgba(45, 212, 232, 0.35); opacity: 0; filter: blur(6px); }\n.heart-vessels { fill: none; stroke: rgb(95, 227, 242); stroke-width: 3.2px; stroke-linecap: round; }\n.heart-alert .heart-vessels { stroke: rgb(255, 107, 122); }\n.heart-line { fill: none; stroke: rgba(110, 0, 20, 0.6); stroke-width: 1.1px; stroke-linecap: round; }\n.spark { fill: rgb(191, 246, 255); opacity: 0.2; animation: 4s ease-in-out 0s infinite normal none running spark; }\n@keyframes spark { \n  50% { opacity: 0.85; }\n}\n.floor-ring { fill: none; stroke: rgba(127, 232, 255, 0.45); stroke-width: 1.2px; }\n.floor-ring.spin { stroke-dasharray: 18, 10; animation: 14s linear 0s infinite normal none running floorspin; }\n@keyframes floorspin { \n  100% { stroke-dashoffset: -280px; }\n}\n.twin-aura { stroke-width: 4px; }\n@media (prefers-reduced-motion: reduce) {\n  .veins path, .spark, .floor-ring.spin { animation: auto ease 0s 1 normal none running none; }\n}\n.tile.is-linked { border-color: var(--st); box-shadow: 0 0 0 1px var(--st), 0 8px 28px -8px color-mix(in srgb, var(--st) 55%, transparent); transform: translateY(-2px); }\n.twin-spot.is-linked .twin-halo { fill: color-mix(in srgb, var(--st) 38%, transparent); stroke-width: 2px; }\n.twin-spot.is-linked .twin-leader { opacity: 1; stroke-width: 1.6px; }\n.twin-chip.is-linked { border-color: var(--st); background: rgba(255, 255, 255, 0.1); }\n.pulse-spark { background: var(--act); width: 10px; height: 10px; box-shadow: 0 0 14px 4px color-mix(in srgb, var(--act) 70%, transparent); pointer-events: none; z-index: 5; opacity: 0; border-radius: 50%; position: absolute; top: -5px; left: -5px; }\n.tile:focus-visible { outline: 2px solid var(--st); outline-offset: 2px; }\n"